{
  "openapi": "3.1.0",
  "info": {
    "title": "backend-website",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "General"
        ],
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Health check successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "version": "0.1.0"
                }
              }
            }
          }
        }
      }
    },
    "/hello": {
      "get": {
        "tags": [
          "General"
        ],
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Simple Hello Response!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                },
                "example": {
                  "message": "Hello from Financiar backend!",
                  "status": "ok",
                  "version": "0.1.0"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User logged in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUserResponse"
                },
                "example": {
                  "code": 200,
                  "message": "Login successful",
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
              }
            }
          },
          "400": {
            "description": "Missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUserResponse"
                },
                "example": {
                  "code": 400,
                  "message": "Email and password are required"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUserResponse"
                },
                "example": {
                  "code": 401,
                  "message": "Invalid email or password"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUserResponse"
                },
                "example": {
                  "code": 500,
                  "message": "An unexpected error occurred. Please try again later."
                }
              }
            }
          }
        }
      }
    },
    "/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterUserResponse"
                },
                "example": {
                  "code": 200,
                  "message": "User registered successfully"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterUserResponse"
                },
                "examples": {
                  "Invalid Email": {
                    "summary": "Triggered when the email is invalid (either wrong format or not provided)",
                    "value": {
                      "code": 400,
                      "message": "Invalid e-mail"
                    }
                  },
                  "Invalid Risk Profile": {
                    "summary": "Triggered when risk profile is not a permitted value",
                    "value": {
                      "code": 400,
                      "message": "Invalid risk profile. Must be 'conservative', 'moderate', or 'aggressive'."
                    }
                  },
                  "Weak Password": {
                    "summary": "Triggered when password requirements are not met",
                    "value": {
                      "code": 400,
                      "message": "Password must be at least 8 characters long and contain a mix of letters, numbers, and special characters"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "User already exists for that email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterUserResponse"
                },
                "example": {
                  "code": 409,
                  "message": "User already exists for that email!"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterUserResponse"
                },
                "example": {
                  "code": 500,
                  "message": "An unexpected error occurred. Please try again later."
                }
              }
            }
          }
        }
      }
    },
    "/shares": {
      "get": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "List of all available share tickers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAllSharesResponse"
                },
                "example": {
                  "shares": [
                    {
                      "id": 1,
                      "ticker": "GGAL"
                    },
                    {
                      "id": 2,
                      "ticker": "YPF"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/shares/update": {
      "get": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Tickers synced successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/user": {
      "get": {
        "tags": [
          "User"
        ],
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Authenticated user retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserResponse"
                },
                "example": {
                  "created_at": "2026-05-13T12:00:00Z",
                  "email": "financiar186@gmail.com",
                  "full_name": "John Doe",
                  "id": 1,
                  "is_active": true,
                  "risk_profile": "moderate"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Authenticated user no longer exists"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "User"
        ],
        "operationId": "handler",
        "responses": {
          "204": {
            "description": "Authenticated user (and all related data) deleted successfully"
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Authenticated user no longer exists"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/user/shares": {
      "get": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "List of shares declared by the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListSharesResponse"
                },
                "example": {
                  "shares": [
                    {
                      "created_at": "2026-05-28T12:00:00Z",
                      "entry_price": 1520.5,
                      "id": 1,
                      "quantity": 10,
                      "ticker": "GGAL",
                      "user_id": 42
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Share added to the authenticated user's portfolio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateShareResponse"
                },
                "example": {
                  "created_at": "2026-05-28T12:00:00Z",
                  "entry_price": 1520.5,
                  "id": 1,
                  "quantity": 10,
                  "ticker": "GGAL",
                  "user_id": 42
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data"
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "409": {
            "description": "The authenticated user already has this ticker in their portfolio"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/user/shares/pnl": {
      "get": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Ganancia/perdida (P&L) por ticker y agregada de la cartera del usuario autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PnlResponse"
                },
                "example": {
                  "portfolio": {
                    "total_current_value": 18000.0,
                    "total_invested": 15000.0,
                    "total_pnl_amount": 3000.0,
                    "total_pnl_percentage": 20.0
                  },
                  "shares": [
                    {
                      "current_price": 1800.0,
                      "entry_price": 1500.0,
                      "id": 1,
                      "pnl_amount": 3000.0,
                      "pnl_percentage": 20.0,
                      "quantity": 10,
                      "ticker": "GGAL"
                    },
                    {
                      "current_price": 900.0,
                      "entry_price": null,
                      "id": 2,
                      "pnl_amount": null,
                      "pnl_percentage": null,
                      "quantity": 5,
                      "ticker": "YPFD"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/user/shares/portfolio/recomendacion": {
      "get": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "description": "Modelo de prediccion de tendencia a usar (ver /models en api-ml para el default vigente)",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "cartera_ancla",
            "in": "path",
            "description": "Estrategia de cartera ancla: propia | equal_weight | mercado",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pesos de cartera recomendados (Black-Litterman) para el usuario autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioRecomendacionResponse"
                },
                "example": {
                  "pesos_recomendados": {
                    "GGAL": 0.42,
                    "PAMP": 0.27,
                    "YPFD": 0.31
                  }
                }
              }
            }
          },
          "400": {
            "description": "El usuario no tiene perfil de riesgo configurado"
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Modelo de prediccion desconocido"
          },
          "422": {
            "description": "No hay suficientes datos para calcular la recomendacion"
          },
          "500": {
            "description": "Internal server error"
          },
          "501": {
            "description": "Estrategia de cartera ancla solicitada todavia no implementada"
          },
          "502": {
            "description": "api-ml no pudo responder"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/user/shares/trends": {
      "get": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "responses": {
          "200": {
            "description": "Trend prediction (Modal) for each stock declared by the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListTrendsResponse"
                },
                "example": {
                  "trends": [
                    {
                      "as_of": "2026-06-17",
                      "available": true,
                      "condition": "neutral",
                      "horizon_days": 5,
                      "last_close": 8365.0,
                      "model": "lstm",
                      "model_version": "lstm-20260618T003942Z",
                      "predicted_close": 8511.82,
                      "reason": null,
                      "rsi": 58.3,
                      "signal": "alza",
                      "ticker": "GGAL"
                    },
                    {
                      "as_of": null,
                      "available": false,
                      "condition": null,
                      "horizon_days": null,
                      "last_close": null,
                      "model": null,
                      "model_version": null,
                      "predicted_close": null,
                      "reason": "No se pudo contactar a api-ml",
                      "rsi": null,
                      "signal": null,
                      "ticker": "YPFD"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/user/shares/{id}": {
      "put": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the share to update",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Share updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateShareResponse"
                },
                "example": {
                  "created_at": "2026-05-28T12:00:00Z",
                  "entry_price": 1520.5,
                  "id": 1,
                  "quantity": 25,
                  "ticker": "GGAL",
                  "user_id": 42
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data"
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Share not found for the authenticated user"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the share to delete",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Share deleted successfully"
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "404": {
            "description": "Share not found for the authenticated user"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/user/shares/{ticker}/history": {
      "get": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Ticker (ej: GGAL)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historico de cierres disponible en data-colector",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareHistoryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "502": {
            "description": "data-colector no pudo responder"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/user/shares/{ticker}/trends/compare": {
      "get": {
        "tags": [
          "Share"
        ],
        "operationId": "handler",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Ticker a comparar (ej: GGAL)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Compara los modelos productivos de tendencia desplegados en Modal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareTrendsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token"
          },
          "502": {
            "description": "Ningun modelo de Modal pudo responder"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CompareTrendsResponse": {
        "type": "object",
        "required": [
          "symbol",
          "predictions"
        ],
        "properties": {
          "as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "predictions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelPredictionItem"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "symbol": {
            "type": "string"
          }
        }
      },
      "CreateShareRequest": {
        "type": "object",
        "required": [
          "ticker",
          "quantity"
        ],
        "properties": {
          "entry_price": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Precio de entrada (precio pagado por accion). Opcional.",
            "example": 1520.5
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "example": 10
          },
          "ticker": {
            "type": "string",
            "example": "GGAL"
          }
        }
      },
      "CreateShareResponse": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "ticker",
          "quantity",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "entry_price": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "ticker": {
            "type": "string"
          },
          "user_id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GetUserResponse": {
        "type": "object",
        "required": [
          "id",
          "email",
          "full_name",
          "is_active",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "is_active": {
            "type": "boolean"
          },
          "risk_profile": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "HelloResponse": {
        "type": "object",
        "required": [
          "status",
          "version",
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "HistoricalPricePoint": {
        "type": "object",
        "required": [
          "ts",
          "close"
        ],
        "properties": {
          "close": {
            "type": "number",
            "format": "double"
          },
          "ts": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ListAllSharesResponse": {
        "type": "object",
        "required": [
          "shares"
        ],
        "properties": {
          "shares": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShareTickerItem"
            }
          }
        }
      },
      "ListSharesResponse": {
        "type": "object",
        "required": [
          "shares"
        ],
        "properties": {
          "shares": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShareItem"
            }
          }
        }
      },
      "ListTrendsResponse": {
        "type": "object",
        "required": [
          "trends"
        ],
        "properties": {
          "trends": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShareTrendItem"
            }
          }
        }
      },
      "LoginUserRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
