DATABASE_URL=postgresql://financiar:financiar@localhost:5432/financiar
PORT=8000
RUST_LOG=info
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_EXPIRATION_HOURS=24
DATA_COLLECTOR_URL=http://localhost:3000
# URL de api-ml (predicciones de tendencia). En docker-compose es
# http://service_api_ml:8000; localmente sin docker usa otro puerto porque
# este mismo backend tambien corre en el 8000.
API_ML_URL=http://localhost:8001
# PIN compartido para /retro (tablero de retro del equipo, ver
# src/endpoints/retro/). Si no esta seteada, /retro/api/* rechaza todo.
RETRO_PIN=change-me
# Alertas por mail de cambio de tendencia (ver src/alerts/). Si SMTP_HOST no
# esta seteado, el job igual corre (mantiene la cache de tendencias al dia)
# pero no envia mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alertas@financiar.app
SMTP_FROM_NAME=FinanciAr
# Cada cuantas horas se revisan cambios de tendencia. Las predicciones solo
# cambian una vez por rueda, asi que con 24 alcanza.
ALERTS_CHECK_INTERVAL_HOURS=24