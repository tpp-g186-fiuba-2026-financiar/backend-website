# Copiar a .env y completar. Valores pensados para levantar con docker compose.

DATABASE_URL=postgres://financiar:financiar@db:5432/financiar
PORT=8500
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

JWT_SECRET=cambiar-por-un-secreto-largo
# JWT_EXPIRATION_HOURS=24

DATA_COLLECTOR_URL=http://service_data_collector:3000
API_ML_URL=http://service_api_ml:8000

# Modelos deployados en Modal (repo models)
MODAL_LSTM_URL=
MODAL_LSTM_PREPARE_URL=
MODAL_XGBOOST_URL=
MODAL_XGBOOST_PREPARE_URL=
MODAL_TRANSFORMER_URL=
MODAL_ARIMA_URL=
MODAL_SVM_URL=
MODAL_GARCH_URL=

# Mails (STARTTLS: puerto 587 o 2525). Sin SMTP_HOST no se mandan mails y,
# con un FRONTEND_URL local, los links de verificacion/reseteo quedan en el log.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=2525
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=FinanciAr

# ALERTS_CHECK_INTERVAL_HOURS=
# WEEKLY_REPORT_CHECK_INTERVAL_HOURS=
# RETRO_PIN=

# Logs. Sin RUST_LOG se usa info para el back y warn para las librerias ruidosas
# (sqlx, hyper, reqwest). Ejemplos: RUST_LOG=debug, RUST_LOG=backend_website=debug,info
# RUST_LOG=info
# LOG_FORMAT=json  # una linea JSON por evento (recomendado en Render)
